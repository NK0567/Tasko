# --- Serveur ---
NODE_ENV=development
PORT=4300
HOST=0.0.0.0
# URL publique de l'API (utilisée pour les callbacks de paiement)
PUBLIC_URL=http://localhost:4300
# Origines CORS autorisées (séparées par des virgules) ; "*" = tout (dev uniquement)
CORS_ORIGINS=*

# --- Base de données (docker-compose ou `npm run db:embedded`, port hôte 5433) ---
POSTGRES_USER=tasko
POSTGRES_PASSWORD=tasko_dev_password
POSTGRES_DB=tasko
DATABASE_URL=postgres://tasko:tasko_dev_password@localhost:5433/tasko
# Base utilisée par `npm test` (créée automatiquement si absente)
TEST_DATABASE_URL=postgres://tasko:tasko_dev_password@localhost:5433/tasko_test

# --- Auth ---
# À REMPLACER en production par une longue chaîne aléatoire (ex. `openssl rand -hex 48`)
JWT_SECRET=dev-only-change-me-please

# --- Paiements ---
# mock | notchpay | campay | monetbil (prend le pas sur le paramètre `payment_provider` stocké en base si défini)
PAYMENT_PROVIDER=
# Fournisseur des versements (prestataires, retraits) : same | mock | notchpay | campay | monetbil (prioritaire sur `payout_provider`)
PAYOUT_PROVIDER=
MOCK_PAYMENT_DELAY_MS=3000
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_HASH_KEY=

# Campay — https://documenter.getpostman.com/view/2391374/T1LV8PVA
# Démo : https://demo.campay.net/api — Production : https://www.campay.net/api
CAMPAY_BASE_URL=https://demo.campay.net/api
# Identifiants de l'application (APP KEYS du tableau de bord) OU jeton permanent CAMPAY_TOKEN
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_TOKEN=
# « Webhook key » de l'application : vérifie la signature JWT (HS256) des callbacks.
# URL de callback à déclarer dans Campay : <PUBLIC_URL>/api/v1/payments/webhook/campay (GET ou POST)
CAMPAY_WEBHOOK_KEY=
# Frais publiés (campay.net) — à modifier seulement si votre contrat diffère
CAMPAY_COLLECT_FEE_RATE=0.02
CAMPAY_PAYOUT_FEE_RATE=0.01
CAMPAY_BANK_TRANSFER_FEE=5000

# Monetbil — https://github.com/Monetbil/monetbil-php (notify_url envoyé automatiquement : <PUBLIC_URL>/api/v1/payments/webhook/monetbil)
MONETBIL_SERVICE_KEY=
MONETBIL_SERVICE_SECRET=
MONETBIL_API_URL=https://api.monetbil.com/payment/v1
MONETBIL_WIDGET_URL=https://api.monetbil.com/widget/v2.1
# Versements Monetbil : API partiellement documentée → désactivés par défaut (false). Ne passer à true qu'après vérification.
MONETBIL_PAYOUT_ENABLED=false
MONETBIL_PAYOUT_URL=https://api.monetbil.com/v1/payouts/withdrawal
# Paiements en mode test Monetbil considérés réussis (statut 7) : true UNIQUEMENT en développement
MONETBIL_ALLOW_TESTMODE=false
# Aucun tarif public (négocié) : renseignez ceux de votre contrat pour l'affichage des frais estimés (ex. 0.03)
MONETBIL_COLLECT_FEE_RATE=
MONETBIL_PAYOUT_FEE_RATE=

# Délai du versement simulé (payout / retraits) ; par défaut = MOCK_PAYMENT_DELAY_MS
MOCK_PAYOUT_DELAY_MS=3000

# --- Données sensibles au repos (V2 : comptes de versement de la trésorerie) ---
# Clé AES-256-GCM : 64 caractères hex (ex. `openssl rand -hex 32`). OBLIGATOIRE en production.
# Sans clé en dev, une clé de développement fixe est utilisée. Changer de clé rend illisibles les comptes déjà chiffrés.
DATA_ENCRYPTION_KEY=

# --- Planificateur interne (libération auto 48 h, rappels, no-show, tenders, récurrences, reversements) ---
# Activé par défaut hors tests ; une seule instance exécute un cycle à la fois (verrou consultatif PostgreSQL).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
