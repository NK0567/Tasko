{
  "name": "tasko-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API Tasko — marketplace camerounaise de petits jobs (Express + PostgreSQL + Socket.IO)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node db/migrate.js",
    "seed": "node seeds/seed.js",
    "db:embedded": "node scripts/embedded-db.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
